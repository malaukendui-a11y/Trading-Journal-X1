{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(npx vitest run*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(node scripts/verify.mjs*)",
      "Bash(git grep *)",
      "Bash(git add *)",
      "PowerShell(npx vitest run*)",
      "PowerShell(npm run build)",
      "PowerShell(npm run lint)",
      "PowerShell(node scripts/verify.mjs*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git grep *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git add *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-Content *)"
    ],
    "ask": [
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(rm *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git commit *)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(npm uninstall*)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Select-String *.env*)",
      "Bash(git push*)",
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git clean*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git commit --amend*)",
      "Bash(npm run dev*)",
      "Bash(npm run preview*)",
      "Bash(npx vite)",
      "Bash(npx vite *)",
      "PowerShell(git push*)",
      "PowerShell(git merge)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase*)",
      "PowerShell(git reset*)",
      "PowerShell(git restore*)",
      "PowerShell(git stash*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -d*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git commit --amend*)",
      "PowerShell(npm run dev*)",
      "PowerShell(npm run preview*)",
      "PowerShell(npx vite)",
      "PowerShell(npx vite *)"
    ]
  }
}
